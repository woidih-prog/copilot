# ---------- Accès ----------
# Le même principe que le copilote : un code à coller dans Suivi R1.
ACCESS_CODE=CHANGE-MOI
PORT=8787
DB_PATH=./data/followup.db
TZ_LOCAL=Europe/Paris

# ---------- Fenêtre d'envoi (heure de Paris) ----------
SEND_DAYS=1,2,3,4,5,6          # 1 = lundi … 7 = dimanche
SEND_FROM=09:30
SEND_TO=19:30
TICK_MINUTES=10

# ---------- Mode d'envoi ----------
# assist : l'agent rédige, tu envoies d'un tap depuis ton WhatsApp (0 €)
# cloud  : envoi automatique par l'API officielle WhatsApp Cloud (payant au message)
TRANSPORT=assist
# validation : chaque message attend ton OK · auto : part tout seul (cloud seulement)
# Pour du 100 % automatique : TRANSPORT=cloud et DEFAULT_SEND_MODE=auto
DEFAULT_SEND_MODE=validation

# ---------- IA (Claude) ----------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# claude-haiku-5-5 coûte ~40x moins cher : à tester sur tes vrais messages.

# ---------- WhatsApp Cloud API (seulement si TRANSPORT=cloud) ----------
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
# Modèles validés par Meta, obligatoires hors fenêtre de 24 h (textes exacts dans le README)
#   relance_suivi (Marketing) : Bonjour {{1}}, {{2}} / Réponds STOP si tu ne veux plus de messages de ma part.
#   rappel_rdv    (Utility)   : Bonjour {{1}}, petit rappel : notre rendez-vous est prévu {{2}}. Tu me confirmes que c'est toujours bon pour toi ?
WA_TEMPLATE_RELANCE=relance_suivi
WA_TEMPLATE_RAPPEL_R2=rappel_rdv
WA_TEMPLATE_LANG=fr

# ---------- Notion (optionnel : ta base éditable à la main) ----------
NOTION_TOKEN=
NOTION_DATABASE_ID=

# ---------- Notifications vers toi (optionnel, gratuit) ----------
# Installe l'app ntfy, abonne-toi à un sujet secret, colle l'URL ici.
NTFY_URL=
PUBLIC_URL=https://vps52897419.tail6d0ac3.ts.net/followup
