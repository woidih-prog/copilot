# ---------- Accès ----------
# Le même principe que le copilote : un code à coller dans Suivi R1.
ACCESS_CODE=CHANGE-MOI
PORT=8787
DB_PATH=./data/followup.db
TZ_LOCAL=Europe/Paris

# ---------- Fenêtre d'envoi (heure de Paris) ----------
SEND_DAYS=1,2,3,4,5,6          # 1 = lundi … 7 = dimanche
SEND_FROM=09:30
SEND_TO=19:30
TICK_MINUTES=10

# ---------- Mode d'envoi ----------
# validation : chaque message attend ton OK dans le digest
# auto       : tout part seul (SMS, mail, Telegram, et WhatsApp en cloud)
DEFAULT_SEND_MODE=validation
# WhatsApp seulement — assist : tu envoies d'un tap (0 €) · cloud : API officielle Meta
TRANSPORT=assist

# ---------- Canaux ----------
# Ordre de préférence quand la fiche ne choisit pas. Un canal sans clés est sauté.
CANAUX=sms,email,whatsapp,telegram
# Ajoutée en bas des mails
SIGNATURE=

# SMS : appli « SMS Gateway for Android » (sms-gate.app), section Cloud server
SMS_GATEWAY_URL=https://api.sms-gate.app/3rdparty/v1
SMS_USER=
SMS_PASS=
SMS_WEBHOOK_TOKEN=un-jeton-long-a-inventer
SMS_MENTION_STOP=premier

# Mail : Gmail + mot de passe d'application (myaccount.google.com/apppasswords)
MAIL_USER=
MAIL_PASS=
MAIL_FROM_NAME=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# Telegram : bot créé avec @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=
TELEGRAM_WEBHOOK_SECRET=
# ton propre numéro de conversation, pour recevoir tes alertes sur Telegram
TELEGRAM_OWNER_CHAT_ID=

# ---------- IA (Claude) ----------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# claude-haiku-5-5 coûte ~40x moins cher : à tester sur tes vrais messages.

# ---------- WhatsApp Cloud API (seulement si TRANSPORT=cloud) ----------
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
# Modèles validés par Meta, obligatoires hors fenêtre de 24 h (textes exacts dans le README)
#   relance_suivi (Marketing) : Bonjour {{1}}, {{2}} / Réponds STOP si tu ne veux plus de messages de ma part.
#   rappel_rdv    (Utility)   : Bonjour {{1}}, petit rappel : notre rendez-vous est prévu {{2}}. Tu me confirmes que c'est toujours bon pour toi ?
WA_TEMPLATE_RELANCE=relance_suivi
WA_TEMPLATE_RAPPEL_R2=rappel_rdv
WA_TEMPLATE_LANG=fr

# ---------- Notion (optionnel : ta base éditable à la main) ----------
NOTION_TOKEN=
NOTION_DATABASE_ID=

# ---------- Notifications vers toi (optionnel, gratuit) ----------
# Installe l'app ntfy, abonne-toi à un sujet secret, colle l'URL ici.
NTFY_URL=
PUBLIC_URL=https://vps52897419.tail6d0ac3.ts.net/followup
